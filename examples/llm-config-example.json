{
    "name": "Medium MCP Server Configuration",
    "version": "1.0.0",
    "description": "Example configuration for integrating Medium MCP Server with LLMs",
    "tools": [
        {
            "name": "get-profile",
            "description": "Get the Medium profile for the integration token",
            "parameters": {}
        },
        {
            "name": "publish-article",
            "description": "Create a Medium post (draft by default)",
            "parameters": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "description": "Title of the article",
                        "minLength": 5,
                        "maxLength": 100,
                        "examples": [
                            "The Future of AI",
                            "Machine Learning Breakthroughs in 2025"
                        ]
                    },
                    "content": {
                        "type": "string",
                        "description": "Markdown content of the article",
                        "minLength": 100,
                        "examples": [
                            "# Introduction to Artificial Intelligence\n\nIn recent years, AI has transformed..."
                        ]
                    },
                    "tags": {
                        "type": "array",
                        "description": "Tags for the article",
                        "items": {
                            "type": "string"
                        },
                        "maxItems": 5,
                        "examples": [
                            [
                                "technology",
                                "ai",
                                "machine-learning"
                            ]
                        ]
                    },
                    "publicationId": {
                        "type": "string",
                        "description": "Optional publication ID for publishing",
                        "examples": [
                            "publication-xyz"
                        ]
                    },
                    "publishStatus": {
                        "type": "string",
                        "enum": [
                            "draft",
                            "public",
                            "unlisted"
                        ],
                        "description": "Defaults to draft"
                    }
                },
                "required": [
                    "title",
                    "content"
                ]
            }
        },
        {
            "name": "get-publications",
            "description": "Retrieve user's Medium publications",
            "parameters": {}
        }
    ],
    "usage_guidelines": {
        "authentication": "Requires an existing Medium integration token (MEDIUM_INTEGRATION_TOKEN). Medium no longer issues new tokens.",
        "privacy_note": "Respect Medium's terms of service and content guidelines",
        "rate_limits": "Adhere to Medium API rate limits"
    }
}
